  {
   "cell_type": "markdown",
   "id": "f2f7861b",
   "metadata": {},
   "source": [
    "# Step 6:Make a test loader (Optional)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a4efe752",
   "metadata": {},
   "outputs": [],
   "source": [
    "def test_verify_metadata_alignment():\n",
    "    import pandas as pd\n",
    "    from biolearn.data.loader import verify_metadata_alignment\n",
    "\n",
    "    omics = {\n",
    "        \"rna\": pd.DataFrame({\"gene1\": [1, 2]}, index=[\"s1\", \"s2\"]),\n",
    "        \"methyl\": pd.DataFrame({\"cg1\": [0.1]}, index=[\"s2\"])\n",
    "    }\n",
    "    metadata = pd.DataFrame({\"age\": [30]}, index=[\"s1\"])\n",
    "\n",
    "    updated_meta = verify_metadata_alignment(omics, metadata)\n",
    "\n",
    "    assert \"s2\" in updated_meta.index  # missing added\n",
    "    assert \"age\" in updated_meta.columns\n"
   ]
  },
